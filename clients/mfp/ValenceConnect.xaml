<plugin:PluginViewBase xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:plugin="clr-namespace:MultiFunPlayer.Plugin;assembly=MultiFunPlayer"
                       xmlns:s="https://github.com/canton7/Stylet"
                       d:DesignHeight="300"
                       d:DesignWidth="420"
                       StatusContent="{Binding Status}"
                       mc:Ignorable="d">
    <!--
      Five groups: Link, Home, Window, Limits, Readback. Every row has a fixed
      height, so an answer, a NACK or a reconnect never moves a control.
      Colors are the machine WebUI palette: reality #4DA6FF is measured truth,
      intent #A78BFA is commanded or not yet confirmed.
      RAIL TRACK WIDTH IS 372 AND IS COUPLED TO RailTrackPx IN ValenceConnect.cs.
    -->

    <plugin:PluginViewBase.Resources>
        <SolidColorBrush x:Key="RailReality" Color="#4DA6FF"/>
        <SolidColorBrush x:Key="RailIntent" Color="#A78BFA"/>
        <SolidColorBrush x:Key="RailTrack" Color="#040507"/>
        <SolidColorBrush x:Key="RailTrackLine" Color="#1D2026"/>
        <SolidColorBrush x:Key="RailBand" Color="#4DA6FF" Opacity="0.14"/>

        <Style x:Key="GroupLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
          Window drag handle. FIXED 0..1 domain: Maximum bound to the rail length
          let Slider coercion write a clamped value back over the draft (see
          WindowMinFrac). Width = track 372 + thumb 20, offset by half a thumb,
          so the thumb center lands on frac*372 like every marker. No
          RepeatButtons and no hit-testable background: only the thumb takes
          the mouse.
        -->
        <Style x:Key="RailHandle" TargetType="{x:Type Slider}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Width" Value="392"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="-10,0,0,0"/>
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Width="20" Background="Transparent">
                                                    <Rectangle Width="3" RadiusX="1" RadiusY="1"
                                                               Fill="{StaticResource RailIntent}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.25"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </plugin:PluginViewBase.Resources>

    <plugin:PluginViewBase.Style>
        <Style TargetType="{x:Type plugin:PluginViewBase}">
            <Setter Property="StatusForeground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Connected">
                    <Setter Property="StatusForeground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Disconnected">
                    <Setter Property="StatusForeground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Connecting">
                    <Setter Property="StatusForeground" Value="{DynamicResource MaterialDesignPendingBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Disconnecting">
                    <Setter Property="StatusForeground" Value="{DynamicResource MaterialDesignPendingBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </plugin:PluginViewBase.Style>

    <!-- The mode button re-negotiates a live session: stream mode is settled in HELLO. -->
    <plugin:PluginViewBase.ToolBarContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource MaterialDesignToolBarButton}"
                    Padding="8"
                    Click="{s:Action OnConnectClick}"
                    ToolTip="Connect / disconnect">
                <material:PackIcon Width="19" Height="19">
                    <material:PackIcon.Style>
                        <Style TargetType="{x:Type material:PackIcon}">
                            <Setter Property="Kind" Value="Play"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Connected">
                                    <Setter Property="Kind" Value="Stop"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Connecting">
                                    <Setter Property="Kind" Value="Stop"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </material:PackIcon.Style>
                </material:PackIcon>
            </Button>
            <Button Style="{StaticResource MaterialDesignToolBarButton}"
                    Padding="8"
                    Click="{s:Action OnToggleModeClick}"
                    ToolTip="Stream mode: segments (curve) or samples (stairs)">
                <material:PackIcon Width="19" Height="19">
                    <material:PackIcon.Style>
                        <Style TargetType="{x:Type material:PackIcon}">
                            <Setter Property="Kind" Value="StairsUp"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSegmentsMode}" Value="True">
                                    <Setter Property="Kind" Value="VectorCurve"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </material:PackIcon.Style>
                </material:PackIcon>
            </Button>
        </StackPanel>
    </plugin:PluginViewBase.ToolBarContent>

    <!-- IsOpen is TwoWay: the host closes the dialog itself (scrim click, Esc). -->
    <material:DialogHost IsOpen="{Binding SetupOpen, Mode=TwoWay}" CloseOnClickAway="True">
        <material:DialogHost.DialogContent>
            <StackPanel Margin="16" Width="340">
                <TextBlock Text="Link" FontWeight="Bold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             material:HintAssist.Hint="Address"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             IsEnabled="{Binding IsEditable}"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="2"
                             material:HintAssist.Hint="Port"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             IsEnabled="{Binding IsEditable}"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="4"
                            VerticalAlignment="Bottom" Height="26" Padding="10,2"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="{s:Action OnDiscoverClick}"
                            IsEnabled="{Binding IsEditable}"
                            ToolTip="Find hubs on the LAN"
                            Content="Discover"/>
                </Grid>

                <ComboBox Margin="0,6,0,0"
                          material:HintAssist.Hint="Discovered hubs"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          IsEnabled="{Binding IsEditable}"
                          ItemsSource="{Binding DiscoveredDevices}"
                          DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedDevice}"/>
                <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="0,3,0,0"
                             Visibility="{Binding IsDiscovering, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             material:HintAssist.Hint="Axis"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             IsEnabled="{Binding IsEditable}"
                             Text="{Binding SourceAxis, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="2"
                             material:HintAssist.Hint="Rate (Hz)"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             IsEnabled="{Binding IsEditable}"
                             Text="{Binding UpdateRateHz, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="4"
                             material:HintAssist.Hint="Paired token"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             IsEnabled="{Binding IsEditable}"
                             Text="{Binding PairingPin, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock FontSize="10" Opacity="0.5" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{Binding CatalogInfo, StringFormat=catalog: {0}}"
                           Visibility="{Binding CatalogInfo, Converter={StaticResource NullableToVisibilityConverter}}"/>
            </StackPanel>
        </material:DialogHost.DialogContent>

        <!-- Background Transparent is load-bearing: an unset background is not
             hit-testable, and a click that falls through drags the MFP window. -->
        <Grid Margin="10,8,10,10" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==== LINK ==== -->
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource GroupLabel}" Text="Link"/>
            <Grid Grid.Row="0" Grid.Column="1" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusText, TargetNullValue=Disconnected}"
                           ToolTip="{Binding StatusText}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10" Opacity="0.6" Margin="8,0,2,0"><Run Text="{Binding Address, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/></TextBlock>
                <Button Grid.Column="2" Width="28" Height="24" Padding="0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="{s:Action OnToggleSetupClick}"
                        ToolTip="Link setup">
                    <material:PackIcon Kind="CogOutline" Width="16" Height="16"/>
                </Button>
            </Grid>
            <Border Grid.Row="1" Grid.Column="1" Height="15">
                <TextBlock FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"><Run Text="{Binding DeviceInfo, Mode=OneWay}"/><Run Text=" · session "/><Run Text="{Binding SessionId, Mode=OneWay}"/><Run Text=" · up "/><Run Text="{Binding Uptime, Mode=OneWay}"/></TextBlock>
            </Border>

            <!-- ==== HOME: the catalog action.home verb and the hub answer ==== -->
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource GroupLabel}" Text="Home"/>
            <Grid Grid.Row="2" Grid.Column="1" Height="24" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="22" Padding="10,0" FontSize="11"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="{s:Action OnHomeClick}"
                        IsEnabled="{Binding CanHome}"
                        ToolTip="Run the homing cycle"
                        Content="Home"/>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding HomeStatus}" ToolTip="{Binding HomeStatus}"/>
            </Grid>

            <!-- ==== WINDOW: draft boxes; Apply/Revert only once the draft differs ==== -->
            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource GroupLabel}" Text="Window"/>
            <Grid Grid.Row="3" Grid.Column="1" Height="24" Margin="0,6,0,0" IsEnabled="{Binding IsWindowEditable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" FontSize="11" Padding="2,1" VerticalContentAlignment="Center"
                         ToolTip="Window lower bound"
                         Text="{Binding WindowMinEdit, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="1" Text=" – " Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" FontSize="11" Padding="2,1" VerticalContentAlignment="Center"
                         ToolTip="Window upper bound"
                         Text="{Binding WindowMaxEdit, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="3" Text=" mm" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="5" Height="22" Padding="8,0" FontSize="11"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="{s:Action OnApplyWindowClick}"
                        Visibility="{Binding IsWindowDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Write the window"
                        Content="Apply"/>
                <Button Grid.Column="7" Height="22" Padding="6,0" FontSize="11"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="{s:Action OnRevertWindowClick}"
                        Visibility="{Binding IsWindowDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Discard the draft"
                        Content="Revert"/>
            </Grid>

            <!-- The rail: band and markers are DEVICE values (decoded STATE); the
                 dashed outline and the handles are the operator draft. The track
                 always draws so the rows never move; without travel roles it
                 stays empty rather than inventing a scale. -->
            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
                  Width="372" Height="28" HorizontalAlignment="Left">
                <Border Background="{StaticResource RailTrack}"
                        BorderBrush="{StaticResource RailTrackLine}"
                        BorderThickness="1" CornerRadius="2"/>
                <Canvas ClipToBounds="True">
                    <Rectangle Canvas.Left="{Binding RailWindowLeftPx}" Canvas.Top="1"
                               Width="{Binding RailWindowWidthPx}" Height="28"
                               Fill="{StaticResource RailBand}"/>
                    <Rectangle Canvas.Left="{Binding RailDraftLeftPx}" Canvas.Top="1"
                               Width="{Binding RailDraftWidthPx}" Height="28"
                               Stroke="{StaticResource RailIntent}" StrokeThickness="1"
                               StrokeDashArray="3 2" Fill="Transparent"
                               Visibility="{Binding IsWindowDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Rectangle Canvas.Left="{Binding RailAxisPx}" Canvas.Top="1" Margin="-1,0,0,0"
                               Width="2" Height="28" Fill="{StaticResource RailIntent}" Opacity="0.5"
                               Visibility="{Binding HasAxisOverlay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               ToolTip="MFP axis request"/>
                    <Rectangle Canvas.Left="{Binding RailTargetPx}" Canvas.Top="4" Margin="-1,0,0,0"
                               Width="2" Height="22" Fill="{StaticResource RailIntent}"
                               Visibility="{Binding HasRailTarget, Converter={StaticResource BooleanToVisibilityConverter}}"
                               ToolTip="Machine setpoint"/>
                    <Rectangle Canvas.Left="{Binding RailPositionPx}" Canvas.Top="1" Margin="-1.5,0,0,0"
                               Width="3" Height="28" RadiusX="1" RadiusY="1"
                               Fill="{StaticResource RailReality}"
                               Visibility="{Binding HasRailPosition, Converter={StaticResource BooleanToVisibilityConverter}}"
                               ToolTip="Measured carriage position"/>
                </Canvas>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Margin="4,0,0,1" FontSize="9" Opacity="0.35" Text="0"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,4,1" FontSize="9" Opacity="0.35"
                           Text="{Binding RailMaxText, StringFormat={}{0} mm}"/>
                <Slider Style="{StaticResource RailHandle}"
                        Value="{Binding WindowMinFrac, Mode=TwoWay}"
                        IsEnabled="{Binding IsWindowEditable}"
                        Visibility="{Binding HasRail, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Window lower bound"/>
                <Slider Style="{StaticResource RailHandle}"
                        Value="{Binding WindowMaxFrac, Mode=TwoWay}"
                        IsEnabled="{Binding IsWindowEditable}"
                        Visibility="{Binding HasRail, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Window upper bound"/>
            </Grid>

            <TextBlock Grid.Row="5" Grid.Column="1" Height="15" Margin="0,3,0,0" FontSize="10" Opacity="0.75"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding WindowStatus}" ToolTip="{Binding WindowStatus}"/>

            <!-- ==== LIMITS: read-only display; nothing sent is scaled to them (RFC-008) ==== -->
            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource GroupLabel}" Text="Limits"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Height="16" Margin="0,4,0,0" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding LimitsText}" ToolTip="Machine-driven ceilings, read-only"/>

            <!-- ==== READBACK: the role-located status line, then link counters ==== -->
            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource GroupLabel}" Text="Readback"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Height="16" Margin="0,4,0,0" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding ReadbackText}" ToolTip="{Binding ReadbackText}"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Height="15" FontSize="10" Opacity="0.6"
                       TextTrimming="CharacterEllipsis"><Run Text="{Binding SentText, Mode=OneWay}"/><Run Text=" · states "/><Run Text="{Binding StatesReceived, Mode=OneWay}"/><Run Text=" · NACKs "/><Run Text="{Binding NackCount, Mode=OneWay}"/><Run Text=" / rl "/><Run Text="{Binding RateLimitedCount, Mode=OneWay}"/><Run Text=" · rtt "/><Run Text="{Binding RttUs, Mode=OneWay}"/><Run Text=" us"/></TextBlock>
            <TextBlock Grid.Row="9" Grid.Column="1" Height="15" FontSize="10" Opacity="0.6"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="Measured end-to-end lag; a meter, drives nothing"><Run Text="lag "/><Run Text="{Binding LagText, Mode=OneWay, TargetNullValue=--}"/><Run Text=" · "/><Run Text="{Binding HubScheduleText, Mode=OneWay}"/><Run Text=" · clock "/><Run Text="{Binding ClockOffsetUs, Mode=OneWay}"/><Run Text=" us"/></TextBlock>
            <TextBlock Grid.Row="10" Grid.Column="1" Height="15" FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MaterialDesignErrorBrush}"
                       Text="{Binding DivergenceWarning}" ToolTip="{Binding DivergenceWarning}"
                       Visibility="{Binding IsSegmentsMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </material:DialogHost>
</plugin:PluginViewBase>
